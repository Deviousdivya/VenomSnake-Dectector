# Copy to .env.local for local development, and add the same names in Vercel > Settings > Environment Variables.

# Google Gemini API key - powers snake identification and the symptom summary.
# SECURITY NOTE: today this key is compiled into the browser bundle (see vite.config.ts), so anyone can read it.
# Restrict the key to your site's domain in Google AI Studio / Cloud Console, or move the calls server-side (see README > Roadmap).
GEMINI_API_KEY=your_key_here

# Optional - NewsAPI.org key for the "Latest news" list on the Insights page. Without it, trusted resource links are shown instead.
NEWS_API_KEY=

# Optional - port for `npm run dev` (default 3000).
# PORT=3000
