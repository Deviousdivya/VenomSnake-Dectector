    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^14.14.0",
    "node-cache": "^5.1.2",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
